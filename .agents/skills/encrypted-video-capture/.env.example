# encrypted-video-capture — environment configuration
# Copy this file to .env and fill in values as needed.

# BlackHole audio device index (auto-detected by preflight; override if needed).
# Run: ffmpeg -f avfoundation -list_devices true -i "" 2>&1
# Look for the [N] index next to "BlackHole 2ch".
BLACKHOLE_DEVICE=

# ASR provider selection (v2 default: openai → OpenRouter primary path).
# Options: auto | faster-whisper | openai | off
# "openai" routes to OpenRouter when OPENROUTER_API_KEY is set; faster-whisper
# large-v3 is the local fallback. Override per course via asrProvider in queue.json.
ASR_PROVIDER=openai

# OpenRouter API key — primary ASR path and the headless summariser (summarize.py).
# Sign up at https://openrouter.ai to get a key.
OPENROUTER_API_KEY=

# OpenAI API key — alternative ASR fallback.
OPENAI_API_KEY=

# Model used by summarize.py to turn a transcript into a lecture note.
OPENROUTER_SUMMARY_MODEL=openai/gpt-4o-mini

# Output directory for lecture .md files.
# Default: courses/ relative to the working directory when the skill is invoked.
OUTPUT_DIR=

# Playback speed multiplier for video recording.
# Valid range: 1.0 (real-time) to 2.0 (double speed). Values outside this range are clamped.
# Higher speeds reduce recording wall-clock time but require pitched-audio-tolerant ASR.
# Override per course via playbackSpeed in queue.json.
PLAYBACK_SPEED=2.0

# Browser for yt-dlp cookie export.
# Note: only affects the yt-dlp --cookies-from-browser probe step.
# Supported values: chrome | firefox | safari | edge
# Safari cookies are not supported by yt-dlp on all platforms.
DEFAULT_BROWSER=chrome
