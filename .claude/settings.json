{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && /Users/snow/.claude/scripts/filename-lint.sh \"$f\"; }; exit 0",
            "timeout": 10,
            "statusMessage": "Filename lint (English/ASCII only)"
          }
        ]
      }
    ]
  }
}
